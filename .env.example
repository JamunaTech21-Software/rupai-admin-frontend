# Copy to .env.local for local overrides. Never commit .env files.
# Only VITE_* variables reach the browser bundle — never put a secret here.

# Leave this as /api/v1 everywhere, including Vercel staging: the refresh-token cookie only works same-origin.
# Base URL the API client calls. Relative by default: the dev server proxies it to the backend locally,
# and on staging/production Nginx serves the web app and the API on the same origin.
VITE_API_BASE_URL=/api/v1

# Dev server only: where /api and /health are proxied (the backend's `npm run dev`).
VITE_API_PROXY_TARGET=http://localhost:4000

# Development only: which features answer from MSW mocks instead of the backend.
#   none (default)  every request goes to the backend
#   all             every feature that has mocks uses them
#   system,users    only these features are mocked
# Switch a feature's mocks off once its [BE] story is Done. Production and staging builds never mock.
VITE_MOCK_API=none
